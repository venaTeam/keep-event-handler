# keep-event-handler/.env — copy this to .env before running (dev-up.sh does
# this automatically if .env is missing). Not named .env.example: this repo's
# .gitignore excludes .env and .env.* outright.
# ============================================================================
# === MESSAGING ===
MESSAGING_TYPE=KAFKA
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC=keep-events
KAFKA_CONSUMER_GROUP=keep-event-handler
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# === DATABASE ===
# MUST match the gateway's DB ("keep"). The event-handler consumes from Kafka
# and writes here; if this points at a different DB, the gateway/UI read from
# "keep" and ingested alerts silently never appear.
DATABASE_CONNECTION_STRING=postgresql://keep:keep@localhost:5432/keep
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# === AUTHENTICATION ===
AUTH_TYPE=noauth
KEEP_DEFAULT_USERNAME=keep
KEEP_DEFAULT_PASSWORD=keep

# === API & NETWORKING ===
# These ports must NOT collide with the gateway (8080).
KEEP_API_URL=http://localhost:8080
PROMETHEUS_METRICS_PORT=8094
HEALTH_CHECK_PORT=8092

# === LOGGING ===
LOG_LEVEL=INFO

# === FEATURE FLAGS ===
PROVISION_RESOURCES=true
KEEP_AUDIT_EVENTS_ENABLED=true
KEEP_ENRICHMENT_DISABLED=false
KEEP_ALERT_FIELDS_ENABLED=true
KEEP_MAINTENANCE_WINDOWS_ENABLED=true
KEEP_CALCULATE_START_FIRING_TIME_ENABLED=true
KEEP_CORRELATION_ENABLED=true
KEEP_STORE_RAW_ALERTS=false
KEEP_STORE_PROVIDER_LOGS=false

# === DEDUPLICATION ===
KEEP_DEDUPLICATION_DISTRIBUTION_ENABLED=true
KEEP_CUSTOM_DEDUPLICATION_DISTRIBUTION_ENABLED=true

# === OTEL ===
KEEP_OTEL_ENABLED=true

# === SECURITY & MISC ===
VERIFY_SSL_CERT=true
SECRET_MANAGER_TYPE=FILE
KEEP_READ_ONLY=false
KEEP_READ_ONLY_BYPASS_KEY=
